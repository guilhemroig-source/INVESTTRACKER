# --- Obligatoire ---
# SEC : nom + e-mail de contact exigés par la politique d'accès EDGAR (remplacer par les vôtres)
SEC_USER_AGENT="Tracker investisseurs contact@example.com"

# --- Analyse technique ---
# Cours journaliers : clé gratuite sur tiingo.com
TIINGO_API_KEY=
# Actions téléchargées par passage (quota gratuit ≈ 50 requêtes/heure)
TIINGO_MAX_PER_RUN=45

# --- SMS ---
# allo | twilio | console (défaut : SMS seulement affiché et journalisé). Twilio : SMS_API_KEY="SID:TOKEN"
SMS_PROVIDER=console
SMS_API_KEY=
SMS_FROM=+33600000000
SMS_TO=+33600000000
# Allo : point d'accès d'envoi de SMS (à confirmer avec pnpm sms test)
ALLO_API_URL=https://api.withallo.com/v1/api/sms
# Secours Twilio (optionnel) : utilisé si l'envoi principal échoue
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# URL de l'appli (lien à la fin des SMS)
APP_URL=http://localhost:3000

# --- Optionnel ---
# Relève les quotas de l'API Congrès de Bargo
BARGO_API_KEY=
# Chemin de la base SQLite (défaut : var/tracker.db à la racine du dépôt)
DATABASE_PATH=
# Protection par mot de passe (obligatoire dès que l'appli est en ligne)
APP_USER=
APP_PASSWORD=
